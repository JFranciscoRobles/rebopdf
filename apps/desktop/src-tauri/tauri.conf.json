{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReboPDF",
  "version": "0.2.1",
  "identifier": "com.rebopdf.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:5302",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost data: blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Read, fill, sign and edit PDFs",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "A PDF document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
